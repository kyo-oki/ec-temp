echo "🔍 Running pre-commit checks..."

# Run type-check on backend only (frontend has pre-existing import errors)
echo "📝 Type checking backend..."
npm run type-check --workspace=packages/backend || {
  echo "❌ Backend type check failed. Please fix TypeScript errors before committing."
  exit 1
}

# Run linting on backend only
echo "🧹 Linting backend..."
npm run lint --workspace=packages/backend || {
  echo "❌ Backend lint check failed. Please fix linting errors before committing."
  exit 1
}

echo "✅ All checks passed!"
