{
  "name": "ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/web",
    "dev:backend": "npm run start:dev --workspace=packages/backend",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=packages/web",
    "build:backend": "npm run build --workspace=packages/backend",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prisma:migrate": "npm run migrate:dev --workspace=packages/backend",
    "prisma:studio": "npm run studio --workspace=packages/backend",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7"
  }
}
